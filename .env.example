# CollegeFootballData: https://collegefootballdata.com
# Header: Authorization: Bearer <key>
CFBD_API_KEY=

# The Odds API: https://the-odds-api.com
# Historical NCAAF: sport=americanfootball_ncaaf
ODDS_API_KEY=

# Slack Incoming Webhook for weekly Pick'em pings (optional; skip if empty)
SLACK_WEBHOOK_URL=

# Optional: edit the same Slack message on every refresh (chat.update).
# Incoming webhooks cannot edit messages. Use a Slack bot token with chat:write
# plus the channel id. Keep SLACK_WEBHOOK_URL as the fallback and for failures.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# Optional: one-click Slack refresh link (Netlify function → GitHub workflow_dispatch).
# Also set these on the Netlify site: PICKEM_REFRESH_SECRET, GITHUB_DISPATCH_TOKEN.
PICKEM_REFRESH_SECRET=
